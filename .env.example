# ==============================================================================
# Spectre-CLI: Digital Séance Agent Configuration
# Hacktoberfest Week 4 "Ghost in the Machine" Challenge
# ==============================================================================

# 1. Local Intelligence (Gemma-2 via Ollama) [Prize Track: Best Use of Gemma]
# Runs 100% locally and offline for privacy. Your forgotten files never leave your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b
EMBED_MODEL=nomic-embed-text

# 2. Long-term Memory (MongoDB Atlas Vector Search) [Prize Track: Best Use of MongoDB Atlas]
# Leave blank to automatically use local file-backed vector store (.spectre_cache/local_memory.json)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=spectre_vault
MONGODB_COLLECTION_NAME=resurrected_artifacts
MONGODB_INDEX_NAME=vector_index

# 3. Observability & Audit (Sentry Agent Tracing) [Prize Track: Best Use of Sentry Agent Tracing]
# Audits LLM inference tokens, tool call latency, and computes local savings vs cloud API
SENTRY_DSN=
SENTRY_ENVIRONMENT=seance-production
SENTRY_TRACES_SAMPLE_RATE=1.0

# 4. Spoken Séance Narrator (ElevenLabs TTS) [Prize Track: Best Use of ElevenLabs]
# Optional. If omitted or offline, falls back to rich terminal typewriter narration.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# 5. Agent Orchestration (Mastra Framework) [Prize Track: Best Use of Mastra]
# Optional bridge to Mastra daemon running 'mastra dev' (default: http://localhost:4111)
# When unreachable, Spectre runs via its built-in Mastra-compatible Python engine.
MASTRA_SERVER_URL=http://localhost:4111
